<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2">

            <Button
                android:id="@+id/btn_type_trapped"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:backgroundTint="@color/button_unselected"
                android:textColor="@color/white"
                android:text="@string/btn_trapped" />

            <Button
                android:id="@+id/btn_type_injured"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:backgroundTint="@color/button_unselected"
                android:textColor="@color/white"
                android:text="@string/btn_injured" />

            <Button
                android:id="@+id/btn_type_fire"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:backgroundTint="@color/button_unselected"
                android:textColor="@color/white"
                android:text="@string/btn_fire" />

            <Button
                android:id="@+id/btn_type_need_evac"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:backgroundTint="@color/button_unselected"
                android:textColor="@color/white"
                android:text="@string/btn_need_evac" />
        </GridLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/severity_label"
            android:textColor="@color/white"
            android:layout_marginTop="16dp" />

        <RadioGroup
            android:id="@+id/rg_severity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rb_sev_low"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:text="@string/severity_low" />

            <RadioButton
                android:id="@+id/rb_sev_medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:text="@string/severity_medium" />

            <RadioButton
                android:id="@+id/rb_sev_high"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:text="@string/severity_high" />

            <RadioButton
                android:id="@+id/rb_sev_critical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/critical_accent"
                android:text="@string/severity_critical" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/casualty_count"
            android:textColor="@color/white"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_cas_minus"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="-"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tv_cas_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn_cas_plus"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="+"
                android:textSize="24sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <EditText
                android:id="@+id/et_notes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/notes_hint"
                android:textColorHint="@color/dark_gray"
                android:textColor="@color/white"
                android:minLines="3"
                android:gravity="top|start"
                android:backgroundTint="@color/white" />

            <ImageButton
                android:id="@+id/btn_mic"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:src="@android:drawable/ic_btn_speak_now"
                android:contentDescription="Dictate Notes" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_send"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            android:text="@string/send_report"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/critical_accent" />

        <Button
            android:id="@+id/btn_clear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/clear"
            android:textColor="@color/white"
            android:backgroundTint="@color/button_unselected" />

    </LinearLayout>
</ScrollView>
